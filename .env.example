# LegalCompass Environment Variables
# Copy this file to .env and fill in your credentials
# Never commit .env to version control

# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Sarvam AI API Key (for Indian language translation)
# Get from: https://www.sarvam.ai/
SARVAM_API_KEY=your_api_key_here

# Flask settings
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=true

# ChromaDB settings (local persistent store)
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=legal_corpus_v1

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Gemini model
GEMINI_MODEL=gemini-2.0-flash

# Retrieval settings
RETRIEVAL_TOP_K=5
MAX_EVIDENCE_CHUNKS=8

# Developer/debug mode (set to true to see internal state in logs)
DEBUG_MODE=false
